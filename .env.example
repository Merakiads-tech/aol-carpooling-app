# ---- Branding ----
# The app name is a variable so it can be changed without touching code.
NEXT_PUBLIC_APP_NAME="OneRide"

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admins ----
# Admins are managed only in the `public.app_admins` table (single source of
# truth). Add a row there to grant admin; the app checks it via is_admin().
# No env var is needed. The first admin is seeded in migration 0001.

# ---- Ride Admins contact (shown on Home) ----
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ---- Google Maps (optional; enables pickup autocomplete) ----
# Places API key with billing. Without it, pickup is a plain text field.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Resend email (optional; enables request/approval emails) ----
RESEND_API_KEY=
RESEND_FROM="OneRide <rides@yourdomain.com>"
